# Copy these into your host's environment settings. Never commit real secret values.

# Product name clients see
BRAND_NAME=Leverage IQ
# Contracting company printed on client agreements
LEGAL_NAME=Resurgence Consulting Services Incorporated
BRAND_ADDRESS=220 Sheila Ave, Daytona Beach, FL 32114

# Public address of the site, no trailing slash
APP_URL=https://leverageiq100.com

# Long random string; signs login cookies
SESSION_SECRET=

# First platform-owner console login, created on first start
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Stripe: operator subscription ($147 per month)
STRIPE_PRICE_ID=price_1UcMDZCtNJvojcHMs2do5Khq
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Anthropic: reads uploaded credit reports and rewords letters
ANTHROPIC_API_KEY=

# Where the database file lives; point this at the host's persistent disk
DATABASE_PATH=/data/app.db

# Sign-up alerts. Email through Resend (verify leverageiq100.com in Resend first)
RESEND_API_KEY=
NOTIFY_FROM=Leverage IQ <alerts@leverageiq100.com>
# Text alerts through Twilio (US numbers need A2P 10DLC registration)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Company sites at <link>.leverageiq100.com (needs a wildcard domain on the host and in DNS)
BASE_DOMAIN=leverageiq100.com
